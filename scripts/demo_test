#!/bin/sh
set -eu

source_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
grep -q -- '-X main.version=0.7.0-local' "$source_root/scripts/demo"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
root="$tmp/demo"
bin="$tmp/bin"
log="$tmp/calls"
mkdir -p "$root/scripts" "$root/locks/tofu" "$bin"
cp "$source_root/scripts/demo" "$root/scripts/demo"
chmod +x "$root/scripts/demo"
printf '%s\n' 'provider lock' >"$root/locks/tofu/.terraform.lock.hcl"

cat >"$bin/tofu" <<'EOF'
#!/bin/sh
set -eu
chdir=${1#-chdir=}
shift
printf 'engine:%s\n' "$*" >>"$CALL_LOG"
for argument in "$@"; do
  case "$argument" in -out=*) : >"${argument#-out=}" ;; esac
done
case "$*" in
  'output -raw northstar_contact_form_id') printf '%s\n' 00000000-0000-4000-8000-000000000001 ;;
  'output -raw northstar_brand_folder_id') printf '%s\n' 10001 ;;
  'output -raw northstar_downloads_folder_id') printf '%s\n' 10002 ;;
  'output -raw northstar_private_file_id') printf '%s\n' 20001 ;;
  'output -raw northstar_public_file_id') printf '%s\n' 20002 ;;
  'output -raw northstar_operator_membership_id') printf '%s\n' 30001 ;;
  'output -raw northstar_operator_crm_profile_id') printf '%s\n' 40001 ;;
  'output -raw northstar_support_product_id') printf '%s\n' 70001 ;;
  'plan -detailed-exitcode -input=false'|'plan -detailed-exitcode -input=false -out='*)
    if test "${PLAN_EXIT_ONCE:-}" = 1 && test ! -e "$PLAN_EXIT_ONCE_MARKER"; then
      : >"$PLAN_EXIT_ONCE_MARKER"
      exit 2
    fi
    exit "${PLAN_EXIT:-0}"
    ;;
  'plan -refresh-only -detailed-exitcode -input=false -out='*) exit 2 ;;
  'show -json '*) printf '%s\n' '{"addresses":["module.forms.hubspot_form_definition.this","module.files_root.hubspot_file.this","module.files_root.hubspot_file_folder.this","module.files_brand.hubspot_file.this","module.files_brand.hubspot_file_folder.this","module.account_memberships.hubspot_account_membership.this","module.crm_user_profiles.hubspot_crm_user_profile.this","module.product_definitions.hubspot_product.this"]}' ;;
esac
EOF
chmod +x "$bin/tofu"

cat >"$tmp/helper" <<'EOF'
#!/bin/sh
set -eu
test "$TF_VAR_northstar_files_prefix" = "$HUBSPOT_NORTHSTAR_FILES_PREFIX"
test "$TF_VAR_northstar_membership_email" = "$HUBSPOT_NORTHSTAR_MEMBERSHIP_EMAIL"
printf 'helper:%s\n' "$*" >>"$CALL_LOG"
case "$1" in
  verify-form-terminal) printf '%s\n' '{"terminal":"archived","active_owned_forms":0,"cleanup":"passed"}' ;;
  verify-files-terminal) printf '%s\n' '{"active_owned_files":0,"active_owned_folders":0,"cleanup":"passed"}' ;;
  verify-membership-terminal) printf '%s\n' '{"active_owned_memberships":0,"cleanup":"passed"}' ;;
  verify-profile-terminal) printf '%s\n' '{"residual":"retained_profile_values","remote_write":"none","cleanup":"passed"}' ;;
  verify-product-terminal) printf '%s\n' '{"terminal":"archived","active_owned_products":0,"cleanup":"passed"}' ;;
esac
EOF
chmod +x "$tmp/helper"

run() {
  PATH="$bin:$PATH" CALL_LOG="$log" HUBSPOT_ACCESS_TOKEN=test HUBSPOT_NORTHSTAR_HELPER_SCRIPT="$tmp/helper" \
    HUBSPOT_NORTHSTAR_FILES_PREFIX=ns_123_1_ HUBSPOT_NORTHSTAR_MEMBERSHIP_EMAIL=northstar-operator@example.com ENGINE=tofu "$root/scripts/demo" registry "$1"
}

run verify
grep -q '^helper:verify-files 10001 10002 20001 20002$' "$log"
grep -q '^helper:verify-membership 30001 northstar-operator@example.com$' "$log"
grep -q '^helper:verify-profile 40001 30001$' "$log"
grep -q '^helper:verify-product 70001$' "$log"

: >"$log"
PLAN_EXIT=2 run drift
grep -q '^helper:drift 00000000-0000-4000-8000-000000000001$' "$log"
grep -q '^helper:drift-files 20002$' "$log"
grep -q '^helper:drift-profile 40001 30001$' "$log"
grep -q '^helper:drift-product 70001$' "$log"
unset PLAN_EXIT

: >"$log"
PLAN_EXIT_ONCE=1 PLAN_EXIT_ONCE_MARKER="$tmp/plan-exit-once" run refresh
grep -q '^helper:archive-for-refresh$' "$log"
grep -q '^helper:archive-product-for-refresh 70001$' "$log"
grep -q '^helper:drift-folder-path 10001 10002$' "$log"
grep -q '^helper:verify-files 10001 10002 20001 20002$' "$log"
test "$(grep -c '^engine:plan -detailed-exitcode -input=false$' "$log")" = 2

: >"$log"
rm -f "$tmp/plan-exit-once"
PLAN_EXIT_ONCE=1 PLAN_EXIT_ONCE_MARKER="$tmp/plan-exit-once" run adopt
grep -q '^engine:import -input=false module.files_root.hubspot_file_folder.this\["brand"\] 10001$' "$log"
grep -q '^engine:import -input=false module.files_brand.hubspot_file_folder.this\["downloads"\] 10002$' "$log"
grep -q '^engine:import -input=false module.files_root.hubspot_file.this\["private_readme"\] 20001$' "$log"
grep -q '^engine:import -input=false module.files_brand.hubspot_file.this\["public_logo"\] 20002$' "$log"
grep -q '^engine:import -input=false module.account_memberships.hubspot_account_membership.this\["northstar_operator"\] email:northstar-operator@example.com$' "$log"
grep -q '^engine:import -input=false module.crm_user_profiles.hubspot_crm_user_profile.this\["northstar_operator"\] membership:30001$' "$log"
grep -q '^engine:import -input=false module.product_definitions.hubspot_product.this\["northstar_support"\] 70001$' "$log"
grep -q '^engine:plan -input=false -out=.*plan\.tfplan$' "$log"
grep -q '^engine:apply -input=false .*plan\.tfplan$' "$log"
test "$(grep -c '^engine:plan -detailed-exitcode -input=false$' "$log")" = 2

: >"$log"
run destroy-plan
run destroy-apply
grep -q '^helper:verify-files-terminal 10001 10002 20001 20002$' "$log"
grep -q '^helper:verify-membership-terminal 30001 northstar-operator@example.com$' "$log"
grep -q '^helper:verify-profile-terminal 40001 30001$' "$log"
grep -q '^helper:verify-product-terminal 70001$' "$log"
test -s "$root/.demo/registry-tofu-destroy/files-terminal.json"
if grep -Eq '10001|10002|20001|20002' "$root/.demo/registry-tofu-destroy/files-terminal.json"; then
  echo 'Files terminal evidence exposed raw identities' >&2
  exit 1
fi
if grep -Eq '30001|northstar-operator@example.com' "$root/.demo/registry-tofu-destroy/membership-terminal.json"; then
  echo 'membership terminal evidence exposed raw identities' >&2
  exit 1
fi
if grep -Eq '40001|30001' "$root/.demo/registry-tofu-destroy/crm-profile-terminal.json"; then
  echo 'CRM profile terminal evidence exposed raw identities' >&2
  exit 1
fi
if grep -Eq '70001' "$root/.demo/registry-tofu-destroy/product-terminal.json"; then
  echo 'Product terminal evidence exposed raw identities' >&2
  exit 1
fi

echo 'Northstar demo lifecycle contract tests passed'
